---
import { projects } from "../../../cv.json";
import Section from "../Section.astro";
import GitHub from "../../icons/GitHub.astro";
---

<Section title="Proyectos">
  <ul class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-4">
    {
      projects.map(
        ({img, url, description, highlights, name, isActive, github }) => (
          <li>
            <article class="flex h-full flex-col gap-4 rounded-lg border theme-border p-4">
              <header class="flex-1">
                <h3 class="mb-1 font-medium text-neutral-900">
                  {url ? (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Ver el proyecto ${name}`}
                      class="hover:underline theme-text"
                    >
                      {name}
                    </a>
                  ) : (
                    name
                  )}
                  {isActive && <span class="text-green-600">&bull;</span>}
                  {github && (
                    <a
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Código fuente de ${name}`}
                      class="ml-1 inline-flex align-middle text-neutral-500 hover:text-neutral-900"
                    >
                      <GitHub />
                    </a>
                  )}
                </h3>
                  <img src={img} alt="image" class="p-2">
                <p class="mb-1 font-mono text-xs theme-text leading-5 text-neutral-600">
                  {description}
                </p>
              </header>
              <footer class="flex flex-wrap gap-1 text-xs">
                {highlights.map((highlight) => (
                  <span class="rounded-md bg-neutral-100 px-1.5 py-0.5 font-mono font-medium text-neutral-600">
                    {highlight}
                  </span>
                ))}
              </footer>
            </article>
          </li>
        ),
      )
    }
  </ul>
</Section>
